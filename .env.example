# Paths are resolved relative to the repository root when omitted.
DEVASSIST_ROOT=.
DEVASSIST_DATA_PATH=data/sample/knowledge_base.jsonl
DEVASSIST_EVAL_PATH=data/evaluation/golden_queries.jsonl
DEVASSIST_FEEDBACK_PATH=data/runtime/feedback.jsonl
DEVASSIST_RERANKER_WEIGHTS_PATH=artifacts/reranker/weights.json

# Retrieval and answer calibration.
DEVASSIST_TOP_K=5
DEVASSIST_CANDIDATE_K=20
DEVASSIST_CONFIDENCE_THRESHOLD=0.36
DEVASSIST_MAX_QUERY_CHARS=12000

# Optional. If unset, the reindex endpoint is disabled.
DEVASSIST_ADMIN_TOKEN=replace-with-a-long-random-value

# API protection for the local demo.
DEVASSIST_RATE_LIMIT_REQUESTS=60
DEVASSIST_RATE_LIMIT_WINDOW_SECONDS=60

# Optional OpenAI-compatible local/hosted model. If base URL or model is absent,
# the grounded extractive generator remains active. Never commit a real key.
DEVASSIST_LLM_BASE_URL=
DEVASSIST_LLM_MODEL=
DEVASSIST_LLM_API_KEY=
DEVASSIST_LLM_TIMEOUT_SECONDS=20
